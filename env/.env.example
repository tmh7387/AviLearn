# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (Phase 2)
OPENAI_API_KEY=your-openai-key

# Gemini (via resources/config.py)
GEMINI_API_KEY=your-gemini-key

# AviLearn Portal — where published courses go
# PORTAL_PUBLISH_KEY must equal PUBLISH_API_KEY in the portal's Netlify settings.
PORTAL_URL=https://avilearn-portal.netlify.app
PORTAL_PUBLISH_KEY=your-portal-publish-key
